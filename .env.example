# ============================================================
#  Kavari Stores — environment variables (all optional)
#  Copy to .env for local use, or set them in your host's dashboard.
# ============================================================

# Port to listen on. Hosts usually set this for you.
PORT=5050

# Where the database file lives.
#   Locally:  leave unset — it defaults to ./data
#   On a host: point it at the mounted volume, e.g. /data
# DATA_DIR=/data

# The public address of your site, shown in the startup banner only.
# PUBLIC_URL=https://your-app.example.com
